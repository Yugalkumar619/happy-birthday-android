<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_70sdp"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/home_option_bg"
    android:backgroundTint="@color/color_light_pink"
    android:layout_marginTop="@dimen/_10sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBhajan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:src="@drawable/sri_ram_3"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize15Percent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerCrop"
        android:layout_margin="@dimen/_10sdp"
        app:layout_constraintDimensionRatio="0.8:1"/>

    <LinearLayout
        android:id="@+id/linDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@+id/ivBhajan"
        android:layout_marginEnd="@dimen/_80sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtBhajanTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/biggest_text_size"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/screen_margin"
            style="@style/TextStyleStartBold"
            tools:text="आइए राम जी – भजन"/>

        <TextView
            android:id="@+id/txtBhajanDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginHorizontal="@dimen/screen_margin"
            style="@style/TextStyleStartMedium"
            tools:text="भगवान श्री राम के पावन
चरणों और उनके दिव्य
आगमन को समर्पित है।
भजन की गायिका श्रेया घोसल"/>


    </LinearLayout>
    
    <ImageView
        android:id="@+id/ivShare"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/ic_share"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="@+id/linDetails"
        app:layout_constraintStart_toEndOf="@+id/linDetails"
        app:layout_constraintEnd_toStartOf="@+id/ivPlayPause"/>

    <ImageView
        android:id="@+id/ivPlayPause"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/ic_play"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/linDetails"
        app:layout_constraintStart_toEndOf="@+id/ivShare"/>



</androidx.constraintlayout.widget.ConstraintLayout>