<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mvvm.collage.view.CollageFragment">

    <include
        android:id="@+id/ilToolbar"
        layout="@layout/layout_toolbar" />

    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginVertical="@dimen/_8sdp"
        android:contentDescription="@string/label_collage_preview"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/barrierControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ilToolbar" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="linEditor,linResult" />

    <LinearLayout
        android:id="@+id/linEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/banner_container">

        <TextView
            android:id="@+id/txtAdjustHint"
            style="@style/TextStyleCenterRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:maxLines="1"
            android:text="@string/label_collage_adjust_hint"
            android:textSize="@dimen/section_sub_title_text_size"
            android:visibility="gone" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsCollage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_32sdp"
            app:tabPaddingEnd="@dimen/_2sdp"
            app:tabPaddingStart="@dimen/_2sdp"
            app:tabIndicatorColor="@color/color_pink"
            app:tabSelectedTextColor="@color/color_pink"
            app:tabTextAppearance="@style/CollageTabText"
            app:tabTextColor="@color/color_black" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginTop="@dimen/_6sdp">

            <LinearLayout
                android:id="@+id/linPhotosTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_margin">

                <ImageView
                    android:id="@+id/btnAddPhotos"
                    android:layout_width="@dimen/_58sdp"
                    android:layout_height="@dimen/_58sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/bg_collage_add_photo"
                    android:contentDescription="@string/label_collage_add_photos"
                    android:padding="@dimen/_17sdp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/color_white" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSelectedPhotos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_collage_selected_photo" />

                <TextView
                    android:id="@+id/txtNoPhotos"
                    style="@style/TextStyleStartRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_weight="1"
                    android:text="@string/label_collage_no_photos"
                    android:textSize="@dimen/medium_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linNameTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:fontFamily="@font/font_regular"
                    android:hint="@string/label_collage_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="24"
                    android:textSize="@dimen/medium_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linWishTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_margin"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtSelectedWish"
                    style="@style/TextStyleStartRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textSize="@dimen/label_text_size"
                    tools:text="Wishing you a very Happy Birthday" />

                <TextView
                    android:id="@+id/btnChooseWish"
                    style="@style/CommonButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_36sdp"
                    android:backgroundTint="@color/color_pink"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:text="@string/label_collage_choose_wish"
                    android:textAllCaps="false"
                    android:textSize="@dimen/label_text_size" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTemplates"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_margin"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_collage_template" />

        </FrameLayout>

        <TextView
            android:id="@+id/btnSave"
            style="@style/CommonButtonStyle"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginVertical="@dimen/_8sdp"
            android:backgroundTint="@color/color_pink"
            android:text="@string/label_collage_save"
            android:textAllCaps="false" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/banner_container">

        <TextView
            style="@style/TextStyleCenterSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:text="@string/label_collage_saved"
            android:textSize="@dimen/header_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginVertical="@dimen/_12sdp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShare"
                style="@style/CommonButtonStyle"
                android:layout_width="0dp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/color_pink"
                android:text="@string/label_collage_share"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/btnCreateAnother"
                style="@style/CommonButtonStyle"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/color_blue"
                android:text="@string/label_collage_create_another"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
