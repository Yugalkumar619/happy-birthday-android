<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".mvvm.home.view.HomeFragment">

   <include
       android:id="@+id/ilToolbar"
       layout="@layout/layout_toolbar"
       />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ilToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivBhajanImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/valentine_1"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="1:1"/>

            <TextView
                android:id="@+id/txtBhajan"
                style="@style/TextStyleCenterRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/biggest_text_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginVertical="@dimen/_20sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivBhajanImage"
                tools:text="भगवान श्री राम के पावन चरणों और उनके दिव्य आगमन को समर्पित है।

भजन की गायिका श्रेया घोसल जी है, जो की भजन के माध्यम से कहती है की श्री राम जी आप आईये और इस कलयुग के दौर को मिटाइये, इस दुनिया को बचाइए।
जो भी आपके चरणों में शीश नहीं
झुकता, जो आपको नहीं मानता है,

उन्हें बता दीजिये कोई तीर चलाकर
अपने शक्ति का अहसास दिलाइये।"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>