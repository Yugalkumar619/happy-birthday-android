<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".mvvm.home.view.HomeFragment">

    <!-- TODO: Update blank fragment layout -->

    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="35.3:26.5"
        android:layout_marginTop="@dimen/_20sdp"
        android:src="@drawable/ic_more"
        android:layout_marginStart="@dimen/screen_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ivMore"
        app:layout_constraintBottom_toTopOf="@+id/banner_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_98sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:weightSum="2"
                android:orientation="horizontal">

                <include
                    android:id="@+id/ilImages"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:layout_weight="1"/>

                <include
                    android:id="@+id/ilSaved"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_98sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:weightSum="2"
                android:orientation="horizontal">

                <include
                    android:id="@+id/ilWishes"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:layout_weight="1"/>

                <include
                    android:id="@+id/ilRateUs"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linPremiumFeature"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_98sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:visibility="gone"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:weightSum="2"
                android:orientation="horizontal">

                <include
                    android:id="@+id/ilPremium"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:layout_weight="1"/>

                <include
                    android:id="@+id/ilRingtone"
                    android:visibility="gone"
                    layout="@layout/layout_home_option"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:layout_weight="1"/>

            </LinearLayout>

            <TextView
                android:id="@+id/btnUnlock"
                style="@style/CommonButtonStyle"
                android:layout_marginTop="@dimen/_20sdp"
                android:textAllCaps="false"
                android:elevation="@dimen/_5sdp"
                android:backgroundTint="@color/color_blue"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:text="@string/label_unlock_premium_wishes"/>

            <TextView
                android:id="@+id/btnPurchasePremium"
                style="@style/CommonButtonStyle"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:textAllCaps="false"
                android:layout_marginBottom="@dimen/_30sdp"
                android:textColor="@color/color_black"
                android:backgroundTint="@color/color_light_yellow"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:text="@string/label_go_premium"/>

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>